# Frontend build-time variables (Vite)
# URL of separately hosted HELEN API (auth + chat)
VITE_HELEN_API_URL=https://api.example.com
# Optional explicit auth API URL; defaults to VITE_HELEN_API_URL when omitted
VITE_HELEN_AUTH_API_URL=https://api.example.com

# Server runtime variables
PORT=3001
HELEN_PROVIDER=openai
HELEN_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-with-openai-key
ANTHROPIC_API_KEY=replace-with-anthropic-key
HELEN_ALLOWED_ORIGINS=https://dmankv.github.io,http://localhost:3000,http://localhost:4173
HELEN_FRONTEND_URL=https://dmankv.github.io/Project-HELEN/

# Auth cookie/session security
AUTH_REQUIRE_HTTPS=true
AUTH_SECURE_COOKIES=true
AUTH_COOKIE_NAME=helen_session
AUTH_CSRF_COOKIE_NAME=helen_csrf
AUTH_SESSION_TTL_MS=43200000
AUTH_VERIFY_TTL_MS=86400000
AUTH_RESET_TTL_MS=1800000

# Auth storage/email adapter (no secrets here)
AUTH_DATA_FILE=/var/lib/helen/auth-store.json
AUTH_DEV_EMAIL_OUTBOX_FILE=/var/lib/helen/auth-email-outbox.jsonl
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
