# Frontend build-time variables (Vite)
# ---------------------------------------------------------------------------
# Managed auth (Supabase) – recommended for GitHub Pages.
# Create a free project at https://supabase.com, then copy the values from
# Settings → API. Both are publishable/browser-safe (not secrets).
# Set as GitHub Actions variables (Settings → Secrets and variables → Actions
# → Variables tab) so they are injected at build time by deploy.yml.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Self-hosted Node auth API (optional fallback – not needed for Supabase path)
# URL of separately hosted Daemon API (auth + chat)
VITE_DAEMON_API_URL=https://api.example.com
# Optional explicit auth API URL; defaults to VITE_DAEMON_API_URL when omitted
VITE_DAEMON_AUTH_API_URL=https://api.example.com

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets (server-only — NEVER commit real values)
# Set these via: supabase secrets set KEY=value
# These are NOT injected into the browser bundle.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...           (when DAEMON_PROVIDER=openai)
# ANTHROPIC_API_KEY=sk-ant-...    (when DAEMON_PROVIDER=anthropic)
# DAEMON_PROVIDER=openai          (openai or anthropic; default: openai)
# DAEMON_MODEL=gpt-4o-mini        (optional model override)
#
# Optional Supabase project-access functions (server-only; do not add VITE_ versions):
# SUPABASE_PROJECT_ACCESS_ENCRYPTION_KEY=base64url-encoded-32-byte-key
# SUPABASE_MCP_OAUTH_CLIENT_ID=registered-server-client-id
# SUPABASE_MCP_OAUTH_CLIENT_SECRET=optional-confidential-client-secret
# SUPABASE_MCP_OAUTH_AUTHORIZATION_ENDPOINT=https://...
# SUPABASE_MCP_OAUTH_TOKEN_ENDPOINT=https://...
# SUPABASE_MCP_OAUTH_REVOCATION_ENDPOINT=https://...
# SUPABASE_MCP_OAUTH_SCOPES=offline_access
# SUPABASE_MCP_SECRET_WRITE_CLIENT_ID=separate-write-oauth-client-id
# SUPABASE_MCP_SECRET_WRITE_CLIENT_SECRET=optional-separate-write-client-secret
# SUPABASE_MCP_SECRET_WRITE_OAUTH_SCOPES=offline_access
# SUPABASE_PROJECT_ACCESS_REDIRECT_URI=https://<project>.supabase.co/functions/v1/supabase-project-access
# SUPABASE_PROJECT_ACCESS_APP_URL=https://dmankv.github.io/Project-HELEN/
#
# Optional GitHub App issue-write functions (server-only; do not add VITE_ versions):
# GITHUB_APP_ID=GitHub-App-numeric-id
# GITHUB_APP_CLIENT_ID=GitHub-App-client-id
# GITHUB_APP_CLIENT_SECRET=GitHub-App-client-secret
# GITHUB_APP_PRIVATE_KEY=PKCS8-private-key-held-only-in-Supabase-secrets
# GITHUB_WRITE_ACCESS_ENCRYPTION_KEY=base64url-encoded-32-byte-key
# GITHUB_WRITE_ACCESS_REDIRECT_URI=https://<project>.supabase.co/functions/v1/github-write-access
# GITHUB_WRITE_ACCESS_APP_URL=https://app.example.com/
# GITHUB_WRITE_ACCESS_ALLOWED_ORIGIN=https://app.example.com  # Required: dedicated custom-domain origin; do NOT use https://dmankv.github.io (shared Pages origin)

# Server runtime variables
PORT=3001
DAEMON_PROVIDER=openai
DAEMON_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-with-openai-key
ANTHROPIC_API_KEY=replace-with-anthropic-key
DAEMON_ALLOWED_ORIGINS=https://dmankv.github.io,http://localhost:3000,http://localhost:4173
DAEMON_FRONTEND_URL=https://dmankv.github.io/Project-HELEN/

# Auth cookie/session security
AUTH_REQUIRE_HTTPS=true
AUTH_SECURE_COOKIES=true
AUTH_COOKIE_NAME=daemon_session
AUTH_CSRF_COOKIE_NAME=daemon_csrf
AUTH_SESSION_TTL_MS=43200000
AUTH_VERIFY_TTL_MS=86400000
AUTH_RESET_TTL_MS=1800000

# Auth storage/email adapter (no secrets here)
AUTH_DATA_FILE=/var/lib/daemon/auth-store.json
AUTH_DEV_EMAIL_OUTBOX_FILE=/var/lib/daemon/auth-email-outbox.jsonl
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
