{
  "name": "helen-api",
  "version": "1.0.0",
  "description": "HELEN chat gateway – server-side LLM proxy",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ../node_modules/tsx/dist/cli.mjs index.ts",
    "build": "node ../node_modules/typescript/bin/tsc --project tsconfig.json",
    "typecheck": "node ../node_modules/typescript/bin/tsc --project tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "@types/node": "^20.0.0"
  }
}
