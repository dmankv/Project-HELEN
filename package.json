{
  "name": "ai-interface",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src server",
    "test": "npx tsx tests/daemon-eval.mjs && npx tsx tests/auth-eval.mjs",
    "test:unit": "vitest run",
    "test:server": "node tests/server-api.mjs",
    "cli": "npx tsx src/cli/daemon-cli.ts",
    "server:dev": "npm run dev --prefix server",
    "server:build": "npm run build --prefix server",
    "server:typecheck": "npm run typecheck --prefix server",
    "python:smoke": "python3 tests/defself_l_smoke.py",
    "check:imports": "node tests/check-imports.mjs",
    "check:dist": "node tests/check-dist.mjs",
    "cli:typecheck": "node_modules/.bin/tsc --project tsconfig.cli.json --noEmit",
    "cli:smoke": "npx tsx tests/cli-smoke.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
